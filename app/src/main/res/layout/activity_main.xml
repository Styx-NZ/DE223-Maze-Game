    <androidx.constraintlayout.widget.Group
        android:id="@+id/levelView"
        app:constraint_referenced_ids="imageView1,imageView2,imageView3,imageView4,imageView5,
        imageView6,imageView7,imageView8,imageView9,imageView10,imageView11,imageView12,imageView13,
        imageView14,imageView15, movesTextView, goalsTextView, levelTextView, reset_button"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"/>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/startView"
        app:constraint_referenced_ids="start_button, startTextView"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="visible"/>


